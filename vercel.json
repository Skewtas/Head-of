{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/chatt/import-daily",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/chatt/weekly-email",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/automations/daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/newsletter/process-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/newsletter/process-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/newsletter/process-daily-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/dashboard/refresh-all",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/dashboard/email-summary",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/ops-email-summary",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/dashboard/staff-underfilled",
      "schedule": "0 6 * * 2,4"
    },
    {
      "path": "/api/dashboard/tickets-email",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/dashboard/save-daily-snapshot",
      "schedule": "55 21 * * *"
    },
    {
      "path": "/api/dashboard/snittpris-weekly-email",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/dashboard/forlangda-utan-pris-email",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/dashboard/kommande-vecka-email",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/ekonomi/cron-sync?company=stodona_ab&years=current",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/ekonomi/cron-sync?company=stodona_services&years=current",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/api/ekonomi/cron-sync?company=stodona_ab&years=previous",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/ekonomi/cron-sync?company=stodona_services&years=previous",
      "schedule": "45 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/auth/callback", "destination": "/api/auth/callback" },
    { "source": "/api/timewave/:path*", "destination": "/api/timewave-proxy" },
    { "source": "/api/clients/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/employees/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/teams/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/services/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/agreements/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/missions/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/time/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/invoices/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/payroll/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/tickets/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/jobs/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/import/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/ops/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/contracts/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/hr/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/personalbrev/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/admin/:path*", "destination": "/api/hf-handler" },
    { "source": "/api/ekonomi/:path*", "destination": "/api/hf-handler" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
