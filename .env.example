# App
APP_URL="http://localhost:3000"

# Gemini AI
GEMINI_API_KEY=

# Microsoft OAuth — hämta från https://portal.azure.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Timewave API
TIMEWAVE_CLIENT_ID=
TIMEWAVE_API_KEY=

# Clerk — hämta från https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# SMTP (for newsletter sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Fortnox OAuth — försäljningsfliken (befintlig koppling, scope: invoice)
# Redirect-URI i appen: {APP_URL}/api/fortnox-callback
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

# EKONOMI — gemensam ekonomisk uppföljning (se docs/ekonomi/)
# Fortnox-app (developer.fortnox.se) med scopes: bookkeeping companyinformation invoice supplierinvoice settings
# Redirect-URI i appen: {APP_URL}/api/ekonomi/fortnox/callback
FORTNOX_EKONOMI_CLIENT_ID=
FORTNOX_EKONOMI_CLIENT_SECRET=
# Sätt till "service" om servicekonto är aktiverat för appen hos Fortnox
FORTNOX_EKONOMI_ACCOUNT_TYPE=
# 32 slumpade byte, base64. Skapa med: openssl rand -base64 32
EKONOMI_TOKEN_KEY=
# Kommaseparerade Clerk-användar-id som får se ekonomin. Tomt = ingen i produktion.
EKONOMI_ALLOWED_USER_IDS=
# Skyddar schemalagd hämtning (Vercel Cron skickar den automatiskt)
CRON_SECRET=
